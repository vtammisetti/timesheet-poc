<mvc:View
  controllerName="timesheetsfreestyle.controller.ObjectPage"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns:uxap="sap.uxap"
  xmlns:l="sap.ui.layout"
  xmlns="sap.m">
  <Page id="objectPage" showNavButton="true" navButtonPress="onNavBack" title="Timesheet Details">
    <footer>
      <Toolbar id="objectPageFooterToolbar">
        <Text id="objectPagePoweredByText" text="Powered by" class="tsPoweredByText" />
        <Image
          id="objectPagePoweredByLogo"
          src="{app>/logoUrl}"
          class="tsPoweredByLogo"
          alt="On Device Solutions"
          tooltip="On Device Solutions"
          decorative="false"
          densityAware="false" />
        <ToolbarSpacer id="objectPageFooterSpacer" />
        <Button
          id="submitDraftButton"
          text="Submit"
          icon="sap-icon://paper-plane"
          type="Emphasized"
          enabled="{objectPage>/submitEnabled}"
          press="onSubmitDraftPress" />
      </Toolbar>
    </footer>
    <uxap:ObjectPageLayout id="objectPageLayout" upperCaseAnchorBar="false">

      <uxap:headerTitle>
        <uxap:ObjectPageHeader
          id="objectPageHeader"
          objectTitle="{objectPage>/displayDate}" />
      </uxap:headerTitle>

      <uxap:sections>

        <uxap:ObjectPageSection id="generalInfoSection" title="General Information">
          <uxap:subSections>
            <uxap:ObjectPageSubSection id="generalInfoSubSection">
              <uxap:blocks>
                <l:Grid id="generalInfoGrid" defaultSpan="L4 M6 S12" vSpacing="1" hSpacing="2">
                  <VBox id="generalInfoDateBox">
                    <Label id="generalInfoDateLabel" text="Date" />
                    <Input id="generalInfoDateValue" value="{objectPage>/displayDate}" editable="false" />
                  </VBox>

                  <VBox id="generalInfoEmployeeBox">
                    <Label id="generalInfoEmployeeLabel" text="Employee" />
                    <Input id="generalInfoEmployeeValue" value="{objectPage>/employeeLabel} ({objectPage>/employeeId})" editable="false" />
                  </VBox>

                  <VBox id="generalInfoCompanyCodeBox">
                    <Label id="generalInfoCompanyCodeLabel" text="Company Code" />
                    <Input id="generalInfoCompanyCodeValue" value="{objectPage>/companyCode}" editable="false" />
                  </VBox>

                  <VBox id="generalInfoTotalHoursBox">
                    <Label id="generalInfoTotalHoursLabel" text="Total Hours" />
                    <Input id="generalInfoTotalHoursValue" value="{objectPage>/totalHours}" editable="false" />
                  </VBox>

                  <VBox id="generalInfoLogCountBox">
                    <Label id="generalInfoLogCountLabel" text="Number of Entries" />
                    <Input id="generalInfoLogCountValue" value="{objectPage>/logCount}" editable="false" />
                  </VBox>

                  <VBox id="generalInfoStatusBox">
                    <Label id="generalInfoStatusLabel" text="Overall Status" />
                    <ObjectStatus
                      id="generalInfoStatusValue"
                      text="{objectPage>/overallStatusText}"
                      state="{objectPage>/overallStatusState}"
                      class="sapUiTinyMarginTop" />
                  </VBox>
                </l:Grid>
              </uxap:blocks>
            </uxap:ObjectPageSubSection>
          </uxap:subSections>
        </uxap:ObjectPageSection>

        <uxap:ObjectPageSection id="logsSection" title="Entries">
          <uxap:subSections>
            <uxap:ObjectPageSubSection id="logsSubSection">
              <uxap:blocks>
                <VBox id="logsSectionVBox">
                  <FacetFilter
                    id="logsFacetFilter"
                    type="Simple"
                    showPersonalization="true"
                    showReset="true"
                    showPopoverOKButton="true"
                    reset="onLogFacetFilterReset"
                    confirm="onLogFacetFilterConfirm"
                    class="sapUiSmallMarginBottom">
                    <lists>
                      <FacetFilterList
                        id="logsStatusFacetList"
                        title="Status"
                        key="status"
                        mode="MultiSelect"
                        items="{logFacets>/status}">
                        <items>
                          <FacetFilterItem id="logsStatusFacetItem" text="{logFacets>text}" key="{logFacets>key}" />
                        </items>
                      </FacetFilterList>
                      <FacetFilterList
                        id="logsCategoryFacetList"
                        title="Category"
                        key="category"
                        mode="MultiSelect"
                        items="{logFacets>/category}">
                        <items>
                          <FacetFilterItem id="logsCategoryFacetItem" text="{logFacets>text}" key="{logFacets>key}" />
                        </items>
                      </FacetFilterList>
                      <FacetFilterList
                        id="logsWorkCenterFacetList"
                        title="Work Center"
                        key="workCenter"
                        mode="MultiSelect"
                        items="{logFacets>/workCenter}">
                        <items>
                          <FacetFilterItem id="logsWorkCenterFacetItem" text="{logFacets>text}" key="{logFacets>key}" />
                        </items>
                      </FacetFilterList>
                    </lists>
                  </FacetFilter>

                  <Table
                    id="logsTable"
                    items="{objectPage>/displayLogs}"
                    noDataText="No entries for this date">
                    <headerToolbar>
                      <OverflowToolbar id="logsTableToolbar">
                        <Title id="logsTableTitle" text="Entries ({objectPage>/logCount})" />
                        <ToolbarSpacer id="logsTableToolbarSpacer" />
                        <Button
                          id="editLogButton"
                          text="Edit"
                          icon="sap-icon://edit"
                          type="Transparent"
                          enabled="{objectPage>/editEnabled}"
                          press="onEditLogPress" />
                        <Button
                          id="deleteLogButton"
                          text="Delete"
                          icon="sap-icon://delete"
                          type="Transparent"
                          enabled="{objectPage>/deleteEnabled}"
                          press="onDeleteLogPress" />
                        <SearchField
                          id="logsSearchField"
                          placeholder="Search entries"
                          width="14rem"
                          value="{objectPage>/searchQuery}"
                          liveChange="onLogSearch" />
                      </OverflowToolbar>
                    </headerToolbar>
                    <columns>
                      <!-- Widths are explicit because sap.m.Table defaults to
                           fixedLayout="true": any column left without one just takes an
                           equal share of the table, which left a wide empty gap once the
                           time columns were hidden. Remarks is deliberately the only
                           width-less column, so it absorbs the remaining space. -->
                      <Column id="logSelectCol" width="3rem" hAlign="Center" />
                      <Column id="logWorkCenterCol" width="9rem"><Text id="logWorkCenterColTitle" text="Work Center" /></Column>
                      <Column id="logCategoryCol" width="7rem"><Text id="logCategoryColTitle" text="Category" /></Column>
                      <Column id="logHoursCol" width="6rem" hAlign="End"><Text id="logHoursColTitle" text="Hours" /></Column>
                      <!-- Start/End Time hidden for now. The columns and their cells are
                           kept (and still bound) so re-enabling is just visible="true";
                           the TSAPP tag in remarks is unaffected either way. -->
                      <Column id="logStartTimeCol" visible="false"><Text id="logStartTimeColTitle" text="Start Time" /></Column>
                      <Column id="logEndTimeCol" visible="false"><Text id="logEndTimeColTitle" text="End Time" /></Column>
                      <!-- Hours is right-aligned, so its value ends hard against the left
                           edge of Remarks and the two read as one run of text. The same
                           margin is on the header and the cell below so they stay aligned. -->
                      <Column id="logRemarksCol"><Text id="logRemarksColTitle" text="Remarks" class="sapUiSmallMarginBegin" /></Column>
                      <Column id="logStatusCol" width="9rem" hAlign="End"><Text id="logStatusColTitle" text="Status" /></Column>
                    </columns>
                    <items>
                      <ColumnListItem id="logListItem">
                        <cells>
                          <CheckBox
                            id="logRowCheckBox"
                            selected="{objectPage>selected}"
                            enabled="{objectPage>selectable}"
                            select="onLogRowCheckChange" />
                          <Text id="logWorkCenterCell" text="{objectPage>workCenter}" />
                          <Text id="logCategoryCell" text="{objectPage>category}" />
                          <Text id="logHoursCell" text="{ path: 'objectPage>hours', formatter: '.formatter.normalizeHours' }" />
                          <Text id="logStartTimeCell" text="{ path: 'objectPage>remarks', formatter: '.formatter.parseStartTime' }" />
                          <Text id="logEndTimeCell" text="{ path: 'objectPage>remarks', formatter: '.formatter.parseEndTime' }" />
                          <Text id="logRemarksCell" text="{ path: 'objectPage>remarks', formatter: '.formatter.cleanRemarks' }" class="sapUiSmallMarginBegin" />
                          <ObjectStatus
                            id="logStatusCell"
                            text="{ path: 'objectPage>status', formatter: '.formatter.formatStatus' }"
                            state="{ path: 'objectPage>status', formatter: '.formatter.statusState' }" />
                        </cells>
                      </ColumnListItem>
                    </items>
                  </Table>
                </VBox>
              </uxap:blocks>
            </uxap:ObjectPageSubSection>
          </uxap:subSections>
        </uxap:ObjectPageSection>

      </uxap:sections>
    </uxap:ObjectPageLayout>
  </Page>
</mvc:View>
