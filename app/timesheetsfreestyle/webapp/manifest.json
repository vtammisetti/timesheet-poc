{
  "_version": "1.86.0",
  "sap.app": {
    "id": "timesheetsfreestyle",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:basic",
      "version": "1.28.0",
      "toolsId": "9e2ee918-f55a-4470-b92d-ec7da6d828b5"
    },
    "dataSources": {
      "mainService": {
        "uri": "/odata/v4/timesheet/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.150.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.uxap": {},
        "sap.ui.layout": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "timesheetsfreestyle.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },

    "rootView": {
      "viewName": "timesheetsfreestyle.view.App",
      "type": "XML",
      "id": "App",
      "async": true
    },

    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "viewType": "XML",
        "viewPath": "timesheetsfreestyle.view",
        "controlId": "appNavContainer",
        "controlAggregation": "pages",
        "transition": "slide",
        "async": true
      },
      "routes": [
        {
          "pattern": "",
          "name": "timeEntries",
          "target": "timeEntries"
        },
        {
          "pattern": "objectPage/{date}",
          "name": "objectPage",
          "target": "objectPage"
        }
      ],
      "targets": {
        "timeEntries": {
          "viewName": "TimeEntries",
          "viewId": "timeEntries"
        },
        "objectPage": {
          "viewName": "ObjectPage",
          "viewId": "objectPage"
        }
      }
    }
  }
}
